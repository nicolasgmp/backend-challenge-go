# Copy this file to .env. Every value below is a local example for the Docker Compose stack; none is a real credential.

# PostgreSQL connection used by the service and by the migrations job.
DATABASE_URL=postgres://wallet:local-wallet-password@postgres:5432/wallet?sslmode=disable
# Password of the local PostgreSQL container (must match the one inside DATABASE_URL).
POSTGRES_PASSWORD=local-wallet-password
# Maximum number of connections of each service instance to PostgreSQL.
DB_MAX_CONNS=10
# How long an operation waits for the lock of a wallet before failing as temporarily unavailable.
DB_LOCK_TIMEOUT=5s

# Address the HTTP server listens on. Compose always uses :8080 inside the container; this value is for running the binary directly.
HTTP_ADDR=:8080
# Maximum time to process one HTTP request.
HTTP_REQUEST_TIMEOUT=10s

# Issuer expected in the "iss" claim of every token (the Keycloak realm).
OIDC_ISSUER_URL=http://keycloak:8080/realms/wallet
# Where the public signing keys of the realm are fetched.
OIDC_KEYS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs
# Audience expected in the "aud" claim of every token.
OIDC_AUDIENCE=wallet-service

# SQS endpoint (MiniStack in the local stack).
SQS_ENDPOINT=http://ministack:4566
# AWS region used to sign SQS requests.
AWS_REGION=us-east-1
# Credentials accepted by the local broker.
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key

# How long a reversal waits for the operation it references before being rejected.
PENDING_REFERENCE_TTL=5m
# Maximum time to finish in-flight work on shutdown.
SHUTDOWN_TIMEOUT=25s
# Log level: debug, info, warn or error.
LOG_LEVEL=info

# Keycloak administrator of the local container.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
# Client secrets imported into the realm (placeholders in deploy/keycloak/wallet-realm.json).
KEYCLOAK_INTERNAL_CLIENT_SECRET=local-internal-client-secret
KEYCLOAK_PROVIDER_A_CLIENT_SECRET=local-provider-a-client-secret
KEYCLOAK_PROVIDER_B_CLIENT_SECRET=local-provider-b-client-secret
