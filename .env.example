DATABASE_URL=postgres://wallet:local-wallet-password@postgres:5432/wallet?sslmode=disable
POSTGRES_PASSWORD=local-wallet-password
DB_LOCK_TIMEOUT=5s

HTTP_ADDR=:8080

OIDC_ISSUER_URL=http://keycloak:8080/realms/wallet
OIDC_KEYS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-service

SQS_ENDPOINT=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key

PENDING_REFERENCE_TTL=5m
SHUTDOWN_TIMEOUT=25s

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
KEYCLOAK_INTERNAL_CLIENT_SECRET=local-internal-client-secret
KEYCLOAK_PROVIDER_A_CLIENT_SECRET=local-provider-a-client-secret
KEYCLOAK_PROVIDER_B_CLIENT_SECRET=local-provider-b-client-secret
